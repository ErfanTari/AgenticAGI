EMBEDDING_ENDPOINT=http://YOUR_MAC_STUDIO:1235/v1/embeddings
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Default: LM Studio as the primary model
LLM_ENDPOINT=http://YOUR_MAC_STUDIO:1234/v1/chat/completions
LLM_MODEL=qwen/qwen3.5-35b-a3b
PLANNER_MODEL=qwen/qwen3.5-35b-a3b
EXECUTOR_MODEL=qwen/qwen3.5-35b-a3b

# Gemini cloud fallback (also used by the UI provider toggle as cloud-primary mode)
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_key_here

# Optional Anthropic fallback alternative
# LLM_FALLBACK_PROVIDER=anthropic
# LLM_FALLBACK_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=your_key_here
# SEARCH_ENDPOINT=http://localhost:8080/search?q={query}&format=json
