# Primary LLM: Local/offline OpenAI-compatible endpoint (optional)
LLM_ENDPOINT=http://10.40.20.174:1234/v1
LLM_MODEL=qwen/qwen3-coder-next
# Optional if your server requires auth
LLM_API_KEY=

# Secondary LLM fallback: Google Gemini
GEMINI_API_KEY=your_google_ai_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
LLM_TIMEOUT_MS=20000
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3

# Optional fallback LLM (Anthropic)
LLM_FALLBACK_PROVIDER=anthropic
LLM_FALLBACK_MODEL=claude-sonnet-4-6
ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages
ANTHROPIC_API_KEY=your_anthropic_key_here

# Embeddings (optional, for hybrid search)
EMBEDDING_ENDPOINT=http://YOUR_MAC_STUDIO:1235/v1/embeddings
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DIMENSIONS=768

# Web search (optional)
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
BRAVE_NEWS_ENDPOINT=https://api.search.brave.com/res/v1/news/search
# Optional override for SearXNG/Tavily-compatible search APIs.
# Use {query} placeholder in URL.
# SEARCH_ENDPOINT=http://localhost:8080/search?q={query}&format=json
# Fallback when Brave key is not configured
DUCKDUCKGO_ENDPOINT=https://api.duckduckgo.com/
