{
  "name": "AgenticAGI",
  "version": "0.10.0",
  "description": "Local-first personal AI agent with structured memory system",
  "endpoint": "http://localhost:3000",
  "protocol": "a2a/1.0",
  "capabilities": {
    "memory": {
      "notebooks": [
        "WHO",
        "WHAT",
        "WHEN",
        "HOW",
        "WHY",
        "NOW",
        "PLAN"
      ],
      "relationships": true,
      "versioned": true,
      "hybrid_search": true
    },
    "skills": [
      "calculator",
      "file_reader",
      "web_search",
      "file_writer",
      "run_bash",
      "memory_read",
      "memory_write",
      "content_writer",
      "web_fetch",
      "url_extract",
      "relationship_write",
      "implement_and_test",
      "memory_history",
      "verify_state",
      "generate_and_save_file",
      "patch_file",
      "grep_workspace",
      "list_dir",
      "glob",
      "confirm_plan",
      "request_user_input",
      "skill_schema"
    ],
    "planning": {
      "max_steps": 8,
      "retry": true,
      "verification": true,
      "episodic_memory": true
    }
  },
  "identity": {
    "local_first": true,
    "model": "configurable",
    "owner": "user"
  }
}
