{
  "name": "agentic-agi",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:ui-app": "node scripts/build-macos-launcher.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui": "node server/ui-bootstrap.mjs",
    "ui:open": "node scripts/ui-app-launcher.mjs open",
    "ui:start": "node scripts/ui-app-launcher.mjs start",
    "ui:status": "node scripts/ui-app-launcher.mjs status",
    "ui:stop": "node scripts/ui-app-launcher.mjs stop",
    "stress:p15": "npx tsx scripts/stress-test-p15.ts",
    "stress:p15:codex": "node scripts/stress-test-p15-codex.mjs",
    "stress:p15:live": "node scripts/stress-test-p15-live.mjs",
    "stress:critical": "npx tsx scripts/stress-test-p15.ts",
    "wipe-memory": "node scripts/wipe-memory.mjs",
    "wipe-memory:yes": "node scripts/wipe-memory.mjs --yes"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^17.3.1",
    "gpt-tokenizer": "^3.4.0",
    "ip-address": "^10.1.1",
    "jsdom": "^29.1.0",
    "mathjs": "^15.1.1",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "simple-git": "^3.32.3",
    "typescript": "^5.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
